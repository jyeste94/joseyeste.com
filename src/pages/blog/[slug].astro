---
import Layout from "@/layouts/Layout.astro";
import LinkButton from "@/components/LinkButton.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import { getCollection } from "astro:content";
import DotnetStudyReader from "@/components/DotnetStudyReader.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

if (!post) {
  return Astro.redirect("/blog");
}

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString("es-ES", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });

const isDotnetStudy = post.slug === "dotnet-10-vs-dotnet-11";
const publicationDate = post.data.date.toISOString().slice(0, 10);
const articleURL = new URL(Astro.url.pathname, Astro.site);
if (isDotnetStudy && (!post.data.image || !post.data.imageAlt)) {
  throw new Error("The .NET study requires its approved cover and alternative text.");
}
const studySchema = isDotnetStudy ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description ?? post.data.summary,
  url: articleURL.href,
  mainEntityOfPage: { "@type": "WebPage", "@id": articleURL.href },
  datePublished: publicationDate,
  inLanguage: "es-ES",
  articleSection: post.data.category,
  keywords: post.data.tags.join(", "),
  author: { "@type": "Person", name: "Jose Yeste", url: Astro.site?.href },
  image: {
    "@type": "ImageObject",
    url: new URL(post.data.image!, articleURL).href,
    width: 1200,
    height: 630,
    caption: post.data.imageAlt,
  },
} : null;
const studySchemaJSON = JSON.stringify(studySchema).replace(/[<>&\u2028\u2029]/g, (character) =>
  `\\u${character.charCodeAt(0).toString(16).padStart(4, "0")}`,
);
---

<Layout
  title={isDotnetStudy ? post.data.title : `${post.data.title} | Blog de Jose Yeste`}
  description={post.data.description ?? post.data.summary}
  image={post.data.image}
  article={isDotnetStudy ? {
    publishedDate: publicationDate,
    imageAlt: post.data.imageAlt!,
    imageWidth: 1200,
    imageHeight: 630,
  } : undefined}
>
  <Fragment slot="head">
    {studySchema && <script is:inline type="application/ld+json" set:html={studySchemaJSON} />}
  </Fragment>
  <main class="px-4">
    <SectionContainer id="blog" class="py-16 md:py-24 space-y-10">
      <div class="space-y-4">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-semibold text-yellow-600 transition hover:gap-3 dark:text-yellow-200"
        >
          ← Volver al blog
        </a>
        <span
          class="rounded-full bg-gray-900 px-4 py-1 text-xs font-semibold uppercase tracking-[0.15rem] text-yellow-300 dark:bg-gray-100 dark:text-gray-900"
        >
          {post.data.category}
        </span>
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white">
          {post.data.title}
        </h1>
        <div
          class="flex flex-wrap items-center gap-3 text-sm text-gray-600 dark:text-gray-300"
        >
          <span>{formatDate(post.data.date.toString())}</span>
          <span class="text-gray-400">·</span>
          <span>{post.data.readingTime}</span>
          <span class="text-gray-400">·</span>
          <ul class="flex flex-wrap gap-2">
            {
              post.data.tags.map((tag) => (
                <li class="rounded-full bg-gray-100 px-3 py-1 font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-200">
                  {tag}
                </li>
              ))
            }
          </ul>
        </div>
        {post.data.researchCutoff && <p class="text-sm text-gray-600 dark:text-gray-300">
          Corte de la investigación: <time datetime={post.data.researchCutoff}>{formatDate(post.data.researchCutoff)}</time>.
        </p>}
      </div>

      <article
        class:list={[
          "prose prose-lg mx-auto mt-6 text-gray-800 prose-headings:text-gray-900 prose-a:text-yellow-600 dark:prose-invert dark:text-gray-50 dark:prose-headings:text-white dark:prose-a:text-yellow-300",
          { "dotnet-study": isDotnetStudy },
        ]}
      >
        <Content />
      </article>

      <div
        class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-dashed border-gray-300 bg-white/70 p-6 dark:border-gray-800 dark:bg-gray-900/60"
      >
        <div>
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white">
            ¿Quieres comentar algo?
          </h2>
          <p class="text-gray-700 dark:text-gray-200">
            Escríbeme si quieres que amplíe alguno de estos temas o tienes
            curiosidad por el código.
          </p>
        </div>
        <LinkButton href="mailto:jose.yeste@gmail.com">Abrir email</LinkButton>
      </div>
    </SectionContainer>
  </main>
  {isDotnetStudy && <DotnetStudyReader />}
</Layout>
